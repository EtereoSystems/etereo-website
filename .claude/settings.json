{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/no-main-commit.sh\"",
            "timeout": 10,
            "statusMessage": "Checking branch"
          }
        ]
      }
    ]
  }
}
