{
  "name": "etereo-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "seo": "node scripts/seo.mjs",
    "blog": "node scripts/gen-blog.mjs",
    "fonts": "node scripts/fonts.mjs",
    "predev": "node scripts/gen-blog.mjs && node scripts/seo.mjs",
    "dev": "vite",
    "prebuild": "node scripts/gen-blog.mjs && node scripts/seo.mjs",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/inline-css.mjs",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "preview": "vite preview"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "lenis": "^1.3.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^29.1.1",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.2"
  }
}
